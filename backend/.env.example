PORT=9000
# In production, use the MongoDB Atlas connection string from your host's secret settings.
MONGO_URI=mongodb://localhost:27017/mindly
REDIS_URL=redis://localhost:6379
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Replace both values with separate randomly generated secrets in production.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=24
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX_REQUESTS=20
