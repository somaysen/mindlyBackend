PORT=9000
NODE_ENV=development
# In production, use the MongoDB Atlas connection string from your host's secret settings.
MONGO_URI=mongodb://localhost:27017/mindly
REDIS_URL=redis://localhost:6379
SKIP_REDIS=false
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
# Optional; uncomment and set all three values to enable Cloudinary uploads.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Replace both values with separate randomly generated secrets in production.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=1
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TTL_DAYS=7
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
JSON_BODY_LIMIT=1mb
# Set to the exact trusted proxy count/address only when deployed behind a proxy.
# TRUST_PROXY=1
